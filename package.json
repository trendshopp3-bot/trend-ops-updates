{
  "name": "trend-ops",
  "productName": "Trend Ops",
  "version": "1.1.6",
  "description": "Trend Ops - Sistema profissional de bipagem, etiquetas e operações",
  "main": "main.js",
  "author": "Taka",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "publish": "electron-builder --win nsis --publish always",
    "atualizar": "npm version patch --no-git-tag-version && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "@zxing/library": "0.21.3",
    "electron-updater": "^6.6.2",
    "jsbarcode": "3.11.6",
    "pdfjs-dist": "3.11.174"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.trend.ops",
    "productName": "Trend Ops",
    "asar": true,
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "phone-adb.js",
      "package.json",
      "imile-ui.js",
      "imile-drivers.js",
      "imile-navigation.js"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Trend-Ops-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Trend Ops",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "trendshopp3-bot",
      "repo": "trend-ops-updates",
      "releaseType": "release"
    }
  }
}
